# =============================================================
# Repo-root .gitignore — applies across all subprojects
# (UW-Wiki, Sibyl, Rosetta). Per-project .gitignore files add
# project-specific patterns on top of these.
# =============================================================

# OS metadata
.DS_Store
Thumbs.db

# IDE / editor
.idea/
.vscode/
*.swp
*.swo
*~

# Environment files — never commit any .env at any level
# Only .env.example may be committed.
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Node / JS tooling
node_modules/
.npm
.yarn/cache
.yarn/install-state.gz

# Build outputs
dist/
build/
out/

# Test / coverage
coverage/
.nyc_output/

# Misc
*.pem
*.key
