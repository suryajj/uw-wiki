# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (public — safe in browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Optional alias for older code paths:
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase (server only — bypasses RLS, NEVER ship to client)
SUPABASE_SERVICE_ROLE_KEY=

# OpenRouter (server only)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_HTTP_REFERER=http://localhost:3000
OPENROUTER_X_TITLE=UW Wiki

# Upstash Redis (rate limiting)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Tavily (server only — cold start agent, FRD 5; soft-required)
TAVILY_API_KEY=

# Resend (server only — email notifications, FRD 9; required for FRD 9)
RESEND_API_KEY=
EMAIL_FROM=notifications@uw-wiki.ca

# Optional analytics
POSTHOG_KEY=
POSTHOG_HOST=

# Optional runtime
LOG_LEVEL=info
FEATURE_FLAG_LOCAL_SUPABASE=false
